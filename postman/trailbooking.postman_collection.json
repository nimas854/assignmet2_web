    {
      "name": "4. Resilience (run `docker compose stop trail-service` first)",
      "item": [
        {
          "name": "Create booking - Trail Service down",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/bookings",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "bookings"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"trail_id\": \"{{trail_id}}\",\n  \"hiker_name\": \"Pema Wangmo\",\n  \"hike_date\": \"2026-12-20\",\n  \"group_size\": 3\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Send this 4 times. The first 3 use retries with backoff; after that the circuit breaker is open and the 4th fails instantly."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Service B down: status is 503\", function () { pm.response.to.have.status(503); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Get booking - fallback while Trail Service down",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/bookings/{{booking_id}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "bookings",
                "{{booking_id}}"
              ]
            },
            "description": "Reading still works; trail_name is a fallback text."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Booking still readable: status is 200\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"Fallback trail_name returned\", function () { pm.expect(pm.response.json().trail_name).to.include(\"unavailable\"); });"
                ]
              }
            }
          ]
        }
      ]
    },
