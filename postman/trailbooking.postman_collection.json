{
  "info": {
    "name": "Trail Booking API (WEB303)",
    "description": "REST API exposed by the API Gateway. Run `docker compose up --build`, then run the folders in order.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Trails (happy path)",
      "item": [
        {
          "name": "Create trail",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/trails",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "trails"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Tiger's Nest\",\n  \"difficulty\": \"HARD\",\n  \"distance_km\": 10,\n  \"max_group_size\": 12\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Create trail: status is 201\", function () { pm.response.to.have.status(201); });",
                  "const body = pm.response.json();",
                  "pm.collectionVariables.set(\"trail_id\", body.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "List trails",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/trails",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
